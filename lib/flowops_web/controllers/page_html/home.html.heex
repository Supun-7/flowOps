<!-- HERO SECTION -->
<div class="min-h-screen flex flex-col items-center justify-center bg-gradient-to-br from-purple-950 via-purple-800 to-indigo-900 px-4">

  <!-- Logo + App Name -->
  <div class="flex flex-col items-center mb-8">
    <div class="bg-white/10 rounded-2xl p-4 mb-4 border border-white/20">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <h1 class="text-5xl font-extrabold text-white tracking-tight">FlowOps</h1>
    <p class="text-slate-300 text-sm mt-2 tracking-widest uppercase">Event Operations Platform</p>
  </div>

  <!-- Headline -->
  <p class="text-3xl font-bold text-white text-center max-w-lg mb-3 leading-tight">
    Manage your events, <span class="text-purple-300">effortlessly.</span>
  </p>

  <!-- Subtitle -->
  <p class="text-slate-300 text-center max-w-sm mb-10 text-base leading-relaxed">
    Create, organize, and track your events in real time. Simple, fast, and built for you.
  </p>

  <!-- Buttons -->
  <div class="flex gap-4 flex-wrap justify-center">
    <%= if @current_scope do %>
      <a href="/events" class="btn btn-lg bg-white text-purple-800 font-bold hover:bg-slate-100 border-none shadow-lg rounded-xl">
        Go to Dashboard
      </a>
    <% else %>
      <a href="/users/register" class="btn btn-lg bg-white text-purple-800 font-bold hover:bg-slate-100 border-none shadow-lg rounded-xl">
        Get Started
      </a>
      <a href="/users/log-in" class="btn btn-lg bg-transparent text-white border-2 border-white/40 hover:bg-white/10 font-bold rounded-xl">
        Log In
      </a>
    <% end %>
  </div>

  <!-- Scroll hint -->
  <div class="mt-16 flex flex-col items-center text-slate-400 text-sm">
    <p>Learn more</p>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-1 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</div>

<!-- ABOUT SECTION -->
<div id="about" class="bg-slate-50 py-20 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl font-extrabold text-purple-900 mb-4">About FlowOps</h2>
    <p class="text-slate-500 text-lg leading-relaxed max-w-2xl mx-auto">
      FlowOps is a real-time event operations platform built for organizers who demand precision.
      From planning to execution, manage your team, track live activity, and run events with confidence.
    </p>

    <!-- Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      <div class="bg-white rounded-2xl shadow p-6 text-left border border-slate-100">
        <div class="bg-purple-100 rounded-xl p-3 w-fit mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-800 mb-2">Real-time Updates</h3>
        <p class="text-slate-500 text-sm">Track your team and event status live — no page refreshes needed.</p>
      </div>

      <div class="bg-white rounded-2xl shadow p-6 text-left border border-slate-100">
        <div class="bg-indigo-100 rounded-xl p-3 w-fit mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-800 mb-2">Team Management</h3>
        <p class="text-slate-500 text-sm">Invite committee members, assign roles, and track their availability.</p>
      </div>

      <div class="bg-white rounded-2xl shadow p-6 text-left border border-slate-100">
        <div class="bg-purple-100 rounded-xl p-3 w-fit mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-800 mb-2">Performance Tracking</h3>
        <p class="text-slate-500 text-sm">Monitor attendance, work status, and team performance after every event.</p>
      </div>
    </div>
  </div>
</div>

<!-- DEMO CREDENTIALS SECTION -->
<div id="demo" class="bg-gradient-to-br from-purple-900 via-indigo-900 to-purple-950 py-20 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-6">
      <span class="text-amber-400 text-sm">✨</span>
      <span class="text-white/80 text-sm font-medium">Try it yourself</span>
    </div>
    <h2 class="text-3xl font-extrabold text-white mb-3">Explore with Demo Accounts</h2>
    <p class="text-slate-300 text-lg max-w-xl mx-auto mb-10">
      Log in with any of these accounts to explore the full platform. No sign-up required.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto">
      <!-- Admin Card -->
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-5 border border-white/15 text-left hover:bg-white/15 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 text-lg">👑</span>
          <div>
            <p class="text-white font-bold text-sm">Admin Account</p>
            <p class="text-purple-300 text-xs">Full access — create events, manage teams</p>
          </div>
        </div>
        <div class="bg-black/20 rounded-lg px-3 py-2 font-mono text-sm text-white/90">admin@gmail.com</div>
      </div>

      <!-- Sarah Card -->
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-5 border border-white/15 text-left hover:bg-white/15 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 text-white font-bold text-sm">S</span>
          <div>
            <p class="text-white font-bold text-sm">Sarah — Committee Member</p>
            <p class="text-purple-300 text-xs">View tasks, update attendance</p>
          </div>
        </div>
        <div class="bg-black/20 rounded-lg px-3 py-2 font-mono text-sm text-white/90">sarah@flowops.com</div>
      </div>

      <!-- James Card -->
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-5 border border-white/15 text-left hover:bg-white/15 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 text-white font-bold text-sm">J</span>
          <div>
            <p class="text-white font-bold text-sm">James — Committee Member</p>
            <p class="text-purple-300 text-xs">Pending invitations to accept</p>
          </div>
        </div>
        <div class="bg-black/20 rounded-lg px-3 py-2 font-mono text-sm text-white/90">james@flowops.com</div>
      </div>

      <!-- Mike Card -->
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-5 border border-white/15 text-left hover:bg-white/15 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-orange-500 to-red-500 text-white font-bold text-sm">M</span>
          <div>
            <p class="text-white font-bold text-sm">Mike — Committee Member</p>
            <p class="text-purple-300 text-xs">Tasks assigned, pending invitation</p>
          </div>
        </div>
        <div class="bg-black/20 rounded-lg px-3 py-2 font-mono text-sm text-white/90">mike@flowops.com</div>
      </div>
    </div>

    <div class="mt-6 text-sm text-slate-400">
      Password for all accounts: <code class="bg-white/10 px-2 py-1 rounded text-white/80 font-mono">Demo@2024Secure!</code>
    </div>

    <a href="/users/log-in" class="inline-flex items-center gap-2 mt-8 px-8 py-3 bg-white text-purple-800 font-bold rounded-xl shadow-lg hover:bg-slate-100 transition-colors text-base">
      Try Now →
    </a>
  </div>
</div>
<div id="contact" class="bg-white py-20 px-6">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl font-extrabold text-purple-900 mb-4">Contact Us</h2>
    <p class="text-slate-500 text-lg mb-10">
      Have questions or want to learn more? We'd love to hear from you.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
        <p class="text-2xl mb-2">📧</p>
        <p class="font-semibold text-gray-800">Email</p>
        <p class="text-slate-500 text-sm mt-1">hello@flowops.com</p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
        <p class="text-2xl mb-2">🌍</p>
        <p class="font-semibold text-gray-800">Location</p>
        <p class="text-slate-500 text-sm mt-1">Colombo, Sri Lanka</p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
        <p class="text-2xl mb-2">⚡</p>
        <p class="font-semibold text-gray-800">Built With</p>
        <p class="text-slate-500 text-sm mt-1">Elixir & Phoenix</p>
      </div>
    </div>
  </div>
</div>