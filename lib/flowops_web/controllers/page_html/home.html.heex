<div class="min-h-screen flex flex-col items-center justify-center bg-gradient-to-br from-violet-600 via-fuchsia-500 to-orange-400">

  <!-- Logo + App Name -->
  <div class="flex flex-col items-center mb-8">
    <div class="bg-white/20 rounded-2xl p-4 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <h1 class="text-5xl font-extrabold text-white tracking-tight">FlowOps</h1>
  </div>

  <!-- Headline -->
  <p class="text-2xl font-semibold text-white/90 text-center max-w-md mb-3">
    Manage your events, effortlessly.
  </p>

  <!-- Subtitle -->
  <p class="text-white/70 text-center max-w-sm mb-10 text-base">
    Create, organize, and track your events in real time. Simple, fast, and built for you.
  </p>

  <!-- Buttons -->
  <div class="flex gap-4">
    <a href="/users/register" class="btn btn-lg bg-white text-violet-700 font-bold hover:bg-white/90 border-none shadow-lg">
      Get Started
    </a>
    <a href="/users/log-in" class="btn btn-lg btn-outline text-white border-white hover:bg-white/20 font-bold">
      Log In
    </a>
  </div>

</div>